# U APP environment. Pre-filled — do not edit unless you want to change providers.
# Firebase client config is already embedded in src/data/catalog.ts and works as-is.
VITE_FIREBASE_PROJECT_ID=dmakenow
VITE_FIREBASE_DATABASE_URL=https://dmakenow-default-rtdb.firebaseio.com

# Server-side build token is read by server/index.mjs at runtime.
# Set these in Render → Environment (never commit a real token here).
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_WORKFLOW=android-build.yml
GITHUB_REF=main

# Optional: live ad mediation endpoint and production ad App IDs
VITE_UAPP_ADS_ENDPOINT=
# Optional merchant UPI (or set from Settings → Runtime config → Merchant UPI)
VITE_UAPP_UPI_ID=
VITE_UAPP_UPI_NAME=
